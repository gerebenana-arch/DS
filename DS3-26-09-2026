#Метод простой итерации
#Сначала приводим систему Ax=b к виду x=Bx+c, для этого создаем матрицу B и вектор c
#и заполняем их коэффициентами из матрицы A и вектора b.
#Потом считаем норму матрицы B, чтобы проверить будет ли метод сходиться.
#Дальше первое приближение x берем равным c и в цикле считаем новые значения x по формуле x=Bx+c.
#После каждой итерации сравниваем новый x со старым и когда разница становится достаточно маленькой,
#останавливаем цикл и выводим найденное решение и количество итераций.

import numpy as np


A = np.array([
    [10, -1, 2],
    [-1, 11, -1],
    [2, -1, 10]
], dtype=float)

b = np.array([6, 25, -11], dtype=float)

eps = 0.001
n = len(b)


B = np.zeros((n, n))
c = np.zeros(n)

for i in range(n):
    c[i] = b[i] / A[i, i]

    for j in range(n):
        if i != j:
            B[i, j] = -A[i, j] / A[i, i]


print("Матрица B:")
print(B)

print("\nВектор c:")
print(c)


q = 0

for i in range(n):
    s = 0

    for j in range(n):
        s += abs(B[i, j])

    if s > q:
        q = s


print("\nНорма B:")
print(q)


x_old = c.copy()

k = 0

while True:

    x_new = B @ x_old + c

    k += 1

    difference = np.max(np.abs(x_new - x_old))

    if difference < ((1 - q) / q) * eps:
        break

    x_old = x_new


print("\nРешение:")
print(x_new)

print("\nКоличество итераций:")
print(k)
