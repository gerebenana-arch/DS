#Метод прогонки состоит из двух частей, где прямой ход считывание коэффицентов, а во второй части обратный ход 
#1Ч мы выражаем x1 и x2 в строках 15-16, а потом складывем коэффиценты в alpha и beta, чтобы потом найти по ним х 
#на обратном ходе. Далее в цикле фор начинается прямой ход, где мы считаем коэффицент alpha, а потом и beta. 
#2Ч 2 часть это обратный ход, мы создаем там массив, чтобы записывать найденный х и с конца будем искать его,
#используя цикл фор.
import numpy as np


def progonka(A, B, C, F):
    n = len(C)

    alpha = np.zeros(n + 1)
    beta = np.zeros(n + 1)

    alpha[1] = B[0] / C[0]
    beta[1] = F[0] / C[0]

    for i in range(1, n):
        d = C[i] - A[i] * alpha[i]

        if i < n - 1:
            alpha[i + 1] = B[i] / d

        beta[i + 1] = (F[i] + A[i] * beta[i]) / d

    x = np.zeros(n)

    x[n - 1] = beta[n]

    for i in range(n - 2, -1, -1):
        x[i] = alpha[i + 1] * x[i + 1] + beta[i + 1]

    return x



A = np.array([0, 1, 1], dtype=float)
B = np.array([1, 1, 0], dtype=float)
C = np.array([-2, -3, -2], dtype=float)
F = np.array([-4, -9, -8], dtype=float)


x = progonka(A, B, C, F)

print("Решение:")
print(x)


