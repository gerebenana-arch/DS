import numpy as np


def householder(A):
    A = np.array(A, dtype=float)
    n = len(A)

    for k in range(n - 2):

    
        x = A[k + 1:, k].copy()


        norm_x = np.linalg.norm(x)

        if norm_x == 0:
            continue

        e1 = np.zeros(len(x))
        e1[0] = 1

        if x[0] >= 0:
            v = x + norm_x * e1
        else:
            v = x - norm_x * e1


        u = v / np.linalg.norm(v)


        H_small = np.eye(len(x)) - 2 * np.outer(u, u)


        H = np.eye(n)
        H[k + 1:, k + 1:] = H_small
        
        A = H.T @ A @ H

    return A


A = [
    [4, 1, 6, 4],
    [1, 2, 3, 8],
    [2, 0, 3, 3],
    [2, 1, 3, 4]
]

B = householder(A)

print("До:")
print(np.array(A))

print("\nПосле:")
print(np.round(B, 6))  
